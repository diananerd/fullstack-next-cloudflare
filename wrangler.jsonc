/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "drimit",
    "main": "worker.ts",
    "compatibility_date": "2025-03-01",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "binding": "ASSETS",
        "directory": ".open-next/assets"
    },
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "drimit_shield_db",
            "database_name": "drimit-shield-db",
            "database_id": "7ae44be5-bd72-4f6f-a5d2-21a26ba54ea8",
            "migrations_dir": "./src/drizzle"
        }
    ],
    "r2_buckets": [
        {
            "bucket_name": "drimit-shield-bucket",
            "binding": "drimit_shield_bucket",
            "preview_bucket_name": "drimit-shield-dev-bucket"
        }
    ],
    "vectorize": [
        {
            "binding": "VECTORIZE",
            "index_name": "drimit-shield-index"
        }
    ],
    "ai": {
        "binding": "AI"
    },
    "triggers": {
        "crons": ["* * * * *"]
    },
    "kv_namespaces": [
        {
            "binding": "drimit_shield_kv",
            "id": "f3ddbd40149b47a49203065e47e4cafd",
            "preview_id": "ca462c7fd8ad40ff9005df25f8316933"
        }
    ],
    "vars": {
        "BETTER_AUTH_URL": "https://drimit.io",
        "NEXT_PUBLIC_APP_URL": "https://drimit.io",
        "MODAL_KERNEL_API_URL": "https://diananerdoficial--drimit-shield-kernel-fastapi-app.modal.run/protect",
        "MODAL_KERNEL_STATUS_URL": "https://diananerdoficial--drimit-shield-kernel-fastapi-app.modal.run/status",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51SRx3bPYr42ZFOGH48eoeAzCwcTDmKzx60kQRUnkyZiBMJdd8jgTv1DpkkaqCmKxO3WRCWAYJeyHW3vzsv4YxSmh00F6YFaiwO",
        "R2_ASSET_BASE_URL": "https://assets.drimit.ai"
    },
    "routes": [
        {
            "pattern": "drimit.io",
            "custom_domain": true
        }
    ]
}
